---
import Layout from '../layouts/BlogPost.astro';
import GlowLineSeparator from '@/components/ui/separator/GlowLineSeparator.astro';
const pageTitle = 'PL/SQL';
const pageDescription = 'Programación procedural con PL/SQL en Oracle.';
---

<Layout title={pageTitle} description={pageDescription} pubDate={new Date()} showHeader={false}>

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/evidencias" class="breadcrumb__link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Evidencias
    </a>
  </nav>

  <!-- Page Header -->
  <header class="page-header">
    <div class="page-header__badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <polyline points="16 18 22 12 16 6"/>
        <polyline points="8 6 2 12 8 18"/>
      </svg>
      Programación Procedural
    </div>
    <h1 class="page-header__title page-header__title--plsql">PL/SQL</h1>
    <p class="page-header__sub">Procedural Language / SQL</p>
    <p class="page-header__desc">Bloques anónimos, procedimientos almacenados, funciones y triggers en Oracle.</p>
  </header>

  <GlowLineSeparator />

  <!-- ═══════════════════════════════════════════════════════
       CONTENIDO — Añade tus bloques de código aquí debajo
       ═══════════════════════════════════════════════════════ -->
  <div class="code-content">

    <div class="placeholder">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
        <polyline points="16 18 22 12 16 6"/>
        <polyline points="8 6 2 12 8 18"/>
      </svg>
      <p>Añade aquí tus ejercicios de PL/SQL</p>
    </div>

  </div>

</Layout>

<style>
  .breadcrumb { margin-bottom: 1.5rem; }

  .breadcrumb__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .breadcrumb__link:hover {
    color: rgb(252, 211, 77);
    text-decoration: none;
  }

  .page-header { margin-bottom: 1.5rem; }

  .page-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgb(252, 211, 77);
    background: rgba(252, 211, 77, 0.08);
    border: 1px solid rgba(252, 211, 77, 0.2);
    border-radius: 100px;
    padding: 0.3rem 0.9rem;
    margin-bottom: 1rem;
  }

  .page-header__title {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0 0 0.3rem;
  }

  .page-header__title--plsql {
    background: linear-gradient(135deg, #fef3c7 0%, #fcd34d 55%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-header__sub {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 0 0.6rem;
    letter-spacing: 0.04em;
  }

  .page-header__desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  .code-content {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 4rem 2rem;
    border: 1px dashed rgba(252, 211, 77, 0.2);
    border-radius: var(--radius);
    color: rgba(252, 211, 77, 0.3);
    text-align: center;
  }

  .placeholder p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
</style>
      <pre class="code-block__pre"><code>-- ============================================================
-- TALLER AVANZADO PL/SQL
-- Juan Felipe Valderrama // Santiago Granados
-- 10/04/26
-- ============================================================

-- ============================================================
-- PUNTO 1 — Bloque anónimo: Liquidación individual
-- Req. 7:  Variables con %TYPE referenciando EMPLEADOS
-- Req. 8:  Cursor explícito para horas trabajadas
-- Req. 9:  Aplica Reglas 1, 2 y 3
-- Req. 10: Consulta SANCIONES para excepción de bonificación
-- Req. 11: IF/ELSIF/CASE para tipos de contrato y antigüedad
-- Req. 12: Salida formateada por DBMS_OUTPUT
-- ============================================================

SET SERVEROUTPUT ON SIZE UNLIMITED;


DECLARE
    -- Variables con %TYPE referenciando EMPLEADOS
    v_id_empleado     EMPLEADOS.id_empleado%TYPE     := 1001; -- Cambiar para probar otros
    v_nombre          EMPLEADOS.nombre%TYPE;
    v_tipo_contrato   EMPLEADOS.tipo_contrato%TYPE;
    v_salario_base    EMPLEADOS.salario_base%TYPE;
    v_fecha_ingreso   EMPLEADOS.fecha_ingreso%TYPE;
    v_cod_sede        EMPLEADOS.cod_sede%TYPE;
    v_acepta_vol      EMPLEADOS.acepta_aporte_vol%TYPE;

    -- Variables de cálculo
    v_quincena        VARCHAR2(15) := &#x27;2026-Q1-ENE&#x27;;
    v_antiguedad      NUMBER;
    v_salario_base_q  NUMBER := 0;
    v_valor_hora      NUMBER := 0;
    v_recargos        NUMBER := 0;
    v_bonificacion    NUMBER := 0;
    v_subtotal        NUMBER := 0;
    v_sanciones_6m    NUMBER := 0;
    v_ret_servicios   NUMBER;
    v_rec_nocturno    NUMBER;
    v_rec_dominical   NUMBER;
    v_rec_noct_dom    NUMBER;
    v_nombre_sede     SEDES.nombre_sede%TYPE;

    -- Cursor para horas trabajadas
    CURSOR cur_horas IS
        SELECT tipo_hora, cantidad_horas
        FROM   HORAS_TRABAJADAS
        WHERE  id_empleado = v_id_empleado
        AND    id_quincena = v_quincena;

    r_hora cur_horas%ROWTYPE;

BEGIN
    -- Leer datos del empleado
    SELECT nombre, tipo_contrato, salario_base, fecha_ingreso, cod_sede, acepta_aporte_vol
    INTO   v_nombre, v_tipo_contrato, v_salario_base, v_fecha_ingreso, v_cod_sede, v_acepta_vol
    FROM   EMPLEADOS
    WHERE  id_empleado = v_id_empleado;

    -- Leer nombre de sede
    SELECT nombre_sede INTO v_nombre_sede FROM SEDES WHERE cod_sede = v_cod_sede;

    -- Leer parámetros
    SELECT valor_numerico INTO v_ret_servicios   FROM PARAMETROS WHERE cod_parametro = &#x27;RET_SERVICIOS&#x27;;
    SELECT valor_numerico INTO v_rec_nocturno    FROM PARAMETROS WHERE cod_parametro = &#x27;RECARGO_NOCTURNO&#x27;;
    SELECT valor_numerico INTO v_rec_dominical   FROM PARAMETROS WHERE cod_parametro = &#x27;RECARGO_DOMINICAL&#x27;;
    SELECT valor_numerico INTO v_rec_noct_dom    FROM PARAMETROS WHERE cod_parametro = &#x27;RECARGO_NOCT_DOM&#x27;;

    -- Antigüedad en años
    v_antiguedad := TRUNC(MONTHS_BETWEEN(SYSDATE, v_fecha_ingreso) / 12);

    -- REGLA 1: Salario base quincenal
    IF v_tipo_contrato = &#x27;PLANTA&#x27; THEN
        v_salario_base_q := v_salario_base / 2;
        v_valor_hora     := v_salario_base / 240;
    ELSIF v_tipo_contrato = &#x27;TEMPORAL&#x27; THEN
        -- Horas normales para base
        BEGIN
            SELECT NVL(cantidad_horas, 0) INTO v_valor_hora
            FROM   HORAS_TRABAJADAS
            WHERE  id_empleado = v_id_empleado AND id_quincena = v_quincena AND tipo_hora = &#x27;NORMAL&#x27;;
        EXCEPTION WHEN NO_DATA_FOUND THEN v_valor_hora := 0;
        END;
        v_salario_base_q := v_salario_base * v_valor_hora;
        v_valor_hora     := v_salario_base; -- para recargos, valor_hora = salario_base
    ELSIF v_tipo_contrato = &#x27;SERVICIOS&#x27; THEN
        v_salario_base_q := (v_salario_base - (v_salario_base * v_ret_servicios / 100)) / 2;
    END IF;

    -- REGLA 2: Recargos (solo PLANTA y TEMPORAL)
    IF v_tipo_contrato IN (&#x27;PLANTA&#x27;, &#x27;TEMPORAL&#x27;) THEN
        OPEN cur_horas;
        LOOP
            FETCH cur_horas INTO r_hora;
            EXIT WHEN cur_horas%NOTFOUND;
            IF r_hora.tipo_hora = &#x27;NOCTURNA&#x27; THEN
                v_recargos := v_recargos + r_hora.cantidad_horas * v_valor_hora * (v_rec_nocturno / 100);
            ELSIF r_hora.tipo_hora = &#x27;DOMINICAL&#x27; THEN
                v_recargos := v_recargos + r_hora.cantidad_horas * v_valor_hora * (v_rec_dominical / 100);
            ELSIF r_hora.tipo_hora = &#x27;NOCTURNA_DOM&#x27; THEN
                v_recargos := v_recargos + r_hora.cantidad_horas * v_valor_hora * (v_rec_noct_dom / 100);
            END IF;
        END LOOP;
        CLOSE cur_horas;
    END IF;

    -- REGLA 3: Bonificación por antigüedad (solo PLANTA y TEMPORAL)
    IF v_tipo_contrato IN (&#x27;PLANTA&#x27;, &#x27;TEMPORAL&#x27;) THEN
        -- Verificar sanciones en últimos 6 meses
        SELECT COUNT(*) INTO v_sanciones_6m
        FROM   SANCIONES
        WHERE  id_empleado  = v_id_empleado
        AND    fecha_sancion &gt;= ADD_MONTHS(SYSDATE, -6);

        IF v_sanciones_6m &gt; 2 THEN
            v_bonificacion := 0;
        ELSE
            v_bonificacion := CASE
                WHEN v_antiguedad BETWEEN 3 AND 5   THEN v_salario_base_q * 0.03
                WHEN v_antiguedad BETWEEN 6 AND 10  THEN v_salario_base_q * 0.06
                WHEN v_antiguedad &gt; 10              THEN v_salario_base_q * 0.10
                ELSE 0
            END;
        END IF;
    END IF;

    -- Subtotal
    v_subtotal := v_salario_base_q + v_recargos + v_bonificacion;

    -- Imprimir resultado
    DBMS_OUTPUT.PUT_LINE(&#x27;=== LIQUIDACIÓN QUINCENAL ===&#x27;);
    DBMS_OUTPUT.PUT_LINE(&#x27;Empleado:       &#x27; || v_nombre || &#x27; (&#x27; || v_id_empleado || &#x27;)&#x27;);
    DBMS_OUTPUT.PUT_LINE(&#x27;Sede:           &#x27; || v_nombre_sede);
    DBMS_OUTPUT.PUT_LINE(&#x27;Tipo contrato:  &#x27; || v_tipo_contrato);
    DBMS_OUTPUT.PUT_LINE(&#x27;Antigüedad:     &#x27; || v_antiguedad || &#x27; años&#x27;);
    DBMS_OUTPUT.PUT_LINE(&#x27;-----------------------------&#x27;);
    DBMS_OUTPUT.PUT_LINE(&#x27;Salario base Q: &#x27; || TO_CHAR(v_salario_base_q, &#x27;FM999,999,990.00&#x27;));
    DBMS_OUTPUT.PUT_LINE(&#x27;Recargos:       &#x27; || TO_CHAR(v_recargos,       &#x27;FM999,999,990.00&#x27;));
    DBMS_OUTPUT.PUT_LINE(&#x27;Bonificación:   &#x27; || TO_CHAR(v_bonificacion,   &#x27;FM999,999,990.00&#x27;));
    DBMS_OUTPUT.PUT_LINE(&#x27;-----------------------------&#x27;);
    DBMS_OUTPUT.PUT_LINE(&#x27;SUBTOTAL:       &#x27; || TO_CHAR(v_subtotal,       &#x27;FM999,999,990.00&#x27;));
    DBMS_OUTPUT.PUT_LINE(&#x27;=============================&#x27;);

EXCEPTION
    WHEN NO_DATA_FOUND THEN
        DBMS_OUTPUT.PUT_LINE(&#x27;ERROR: Empleado &#x27; || v_id_empleado || &#x27; no encontrado.&#x27;);
    WHEN OTHERS THEN
        DBMS_OUTPUT.PUT_LINE(&#x27;ERROR: &#x27; || SQLERRM);
END;
/

-- ================================================================================================================================================================

-- ============================================================
-- PUNTO 2 — Funciones standalone encadenadas
-- ============================================================

-- 2.1 fn_salario_base_q (Regla 1: salario base quincenal)
CREATE OR REPLACE FUNCTION fn_salario_base_q(
    p_id_empleado NUMBER,
    p_id_quincena VARCHAR2
) RETURN NUMBER IS
    v_tipo   EMPLEADOS.tipo_contrato%TYPE;
    v_sal    EMPLEADOS.salario_base%TYPE;
    v_horas  NUMBER := 0;
    v_ret    NUMBER;
BEGIN
    SELECT tipo_contrato, salario_base INTO v_tipo, v_sal
    FROM   EMPLEADOS WHERE id_empleado = p_id_empleado;

    IF v_tipo = &#x27;PLANTA&#x27; THEN
        RETURN v_sal / 2;
    ELSIF v_tipo = &#x27;TEMPORAL&#x27; THEN
        BEGIN
            SELECT NVL(cantidad_horas, 0) INTO v_horas
            FROM   HORAS_TRABAJADAS
            WHERE  id_empleado = p_id_empleado
            AND    id_quincena = p_id_quincena
            AND    tipo_hora   = &#x27;NORMAL&#x27;;
        EXCEPTION WHEN NO_DATA_FOUND THEN v_horas := 0;
        END;
        RETURN v_sal * v_horas;
    ELSIF v_tipo = &#x27;SERVICIOS&#x27; THEN
        SELECT valor_numerico INTO v_ret
        FROM   PARAMETROS WHERE cod_parametro = &#x27;RET_SERVICIOS&#x27;;
        RETURN (v_sal - (v_sal * v_ret / 100)) / 2;
    END IF;
    RETURN 0;
END fn_salario_base_q;
/

-- 2.2 fn_recargos (recargos por horas nocturnas, dominicales y nocturno-dominicales (PLANTA y TEMPORAL))
CREATE OR REPLACE FUNCTION fn_recargos(
    p_id_empleado NUMBER,
    p_id_quincena VARCHAR2
) RETURN NUMBER IS
    v_tipo  EMPLEADOS.tipo_contrato%TYPE;
    v_sal   EMPLEADOS.salario_base%TYPE;
    v_vh    NUMBER;
    v_total NUMBER := 0;
    v_rn    NUMBER; v_rd NUMBER; v_rnd NUMBER;
BEGIN
    SELECT tipo_contrato, salario_base INTO v_tipo, v_sal
    FROM   EMPLEADOS WHERE id_empleado = p_id_empleado;

    IF v_tipo = &#x27;SERVICIOS&#x27; THEN RETURN 0; END IF;

    SELECT valor_numerico INTO v_rn  FROM PARAMETROS WHERE cod_parametro = &#x27;RECARGO_NOCTURNO&#x27;;
    SELECT valor_numerico INTO v_rd  FROM PARAMETROS WHERE cod_parametro = &#x27;RECARGO_DOMINICAL&#x27;;
    SELECT valor_numerico INTO v_rnd FROM PARAMETROS WHERE cod_parametro = &#x27;RECARGO_NOCT_DOM&#x27;;

    v_vh := CASE v_tipo WHEN &#x27;PLANTA&#x27; THEN v_sal / 240 ELSE v_sal END;

    FOR r IN (SELECT tipo_hora, cantidad_horas FROM HORAS_TRABAJADAS
              WHERE id_empleado = p_id_empleado AND id_quincena = p_id_quincena) LOOP
        IF    r.tipo_hora = &#x27;NOCTURNA&#x27;    THEN v_total := v_total + r.cantidad_horas * v_vh * (v_rn  / 100);
        ELSIF r.tipo_hora = &#x27;DOMINICAL&#x27;   THEN v_total := v_total + r.cantidad_horas * v_vh * (v_rd  / 100);
        ELSIF r.tipo_hora = &#x27;NOCTURNA_DOM&#x27; THEN v_total := v_total + r.cantidad_horas * v_vh * (v_rnd / 100);
        END IF;
    END LOOP;
    RETURN NVL(v_total, 0);
END fn_recargos;
/

-- 2.3 fn_bonificacion (llama a fn_salario_base_q, debe crearse después)
CREATE OR REPLACE FUNCTION fn_bonificacion(
    p_id_empleado NUMBER
) RETURN NUMBER IS
    v_tipo      EMPLEADOS.tipo_contrato%TYPE;
    v_ingreso   EMPLEADOS.fecha_ingreso%TYPE;
    v_antiguedad NUMBER;
    v_sanciones  NUMBER;
    v_base_q     NUMBER;
    v_pct        NUMBER := 0;
BEGIN
    SELECT tipo_contrato, fecha_ingreso INTO v_tipo, v_ingreso
    FROM   EMPLEADOS WHERE id_empleado = p_id_empleado;

    IF v_tipo = &#x27;SERVICIOS&#x27; THEN RETURN 0; END IF;

    SELECT COUNT(*) INTO v_sanciones FROM SANCIONES
    WHERE  id_empleado  = p_id_empleado
    AND    fecha_sancion &gt;= ADD_MONTHS(SYSDATE, -6);

    IF v_sanciones &gt; 2 THEN RETURN 0; END IF;

    v_antiguedad := TRUNC(MONTHS_BETWEEN(SYSDATE, v_ingreso) / 12);

    v_pct := CASE
        WHEN v_antiguedad BETWEEN 3 AND 5  THEN 0.03
        WHEN v_antiguedad BETWEEN 6 AND 10 THEN 0.06
        WHEN v_antiguedad &gt; 10             THEN 0.10
        ELSE 0
    END;

    -- Usar quincena del taller para obtener base
    v_base_q := fn_salario_base_q(p_id_empleado, &#x27;2026-Q1-ENE&#x27;);
    RETURN v_base_q * v_pct;
END fn_bonificacion;
/

-- 2.4 fn_bruto (No suma auxilio ni bono sede para que coincida con subtotal del Punto 1)
-- Nota: auxilio y bono sede se calcularán dentro del package (Punto 4)
CREATE OR REPLACE FUNCTION fn_bruto(
    p_id_empleado NUMBER,
    p_id_quincena VARCHAR2
) RETURN NUMBER IS
    v_base_q     NUMBER;
    v_recargos   NUMBER;
    v_bonif      NUMBER;
BEGIN
    v_base_q   := fn_salario_base_q(p_id_empleado, p_id_quincena);
    v_recargos := fn_recargos(p_id_empleado, p_id_quincena);
    v_bonif    := fn_bonificacion(p_id_empleado);
    RETURN v_base_q + v_recargos + v_bonif;
END fn_bruto;
/

-- Validación (Coincide con el subtotal del punto 1)

SELECT fn_bruto(1001, &#x27;2026-Q1-ENE&#x27;) FROM DUAL; 

-- ================================================================================================================================================================

-- ============================================================
-- PUNTO 3 — Procedimiento sp_liquidar_empleado
-- Req. 13: Valida existencia del empleado (-20001)
-- Req. 14: Valida estado ACTIVO (-20002)
-- Req. 15: Valida liquidación duplicada (-20003)
-- Req. 16: Calcula conceptos con funciones del Punto 2
-- Req. 17: Maneja caso de neto negativo (Regla 8)
-- Req. 18: Inserta en LIQUIDACION con SEQ_LIQUIDACION.NEXTVAL
-- Req. 19: COMMIT al final
-- ============================================================
CREATE OR REPLACE PROCEDURE sp_liquidar_empleado(
    p_id_empleado NUMBER,
    p_id_quincena VARCHAR2  
) IS
    v_estado         EMPLEADOS.estado%TYPE;
    v_tipo_contrato  EMPLEADOS.tipo_contrato%TYPE;
    v_salario_base   EMPLEADOS.salario_base%TYPE;
    v_cod_sede       EMPLEADOS.cod_sede%TYPE;
    v_acepta_vol     EMPLEADOS.acepta_aporte_vol%TYPE;
    v_horas_normales NUMBER := 0;

    -- Montos calculados
    v_base_q         NUMBER;
    v_recargos       NUMBER;
    v_bonificacion   NUMBER;
    v_aux_transp     NUMBER := 0;
    v_bono_sede      NUMBER := 0;
    v_bruto          NUMBER;

    -- Deducciones
    v_salud          NUMBER := 0;
    v_pension        NUMBER := 0;
    v_fondo          NUMBER := 0;
    v_embargo        NUMBER := 0;
    v_libranzas      NUMBER := 0;
    v_aporte_vol     NUMBER := 0;
    v_total_ded      NUMBER := 0;
    v_neto           NUMBER;
    v_base_embargo   NUMBER;

    -- Parámetros
    v_smlmv          NUMBER;
    v_pct_salud      NUMBER;
    v_pct_pension    NUMBER;
    v_pct_fondo      NUMBER;
    v_umbral_fondo   NUMBER;
    v_aporte_vol_bog NUMBER;
    v_aux_mensual    NUMBER;
    v_base_mensual   NUMBER;

    -- Control neto negativo
    v_embargo_orig   NUMBER;
    v_libranzas_orig NUMBER;
    v_cnt_liq        NUMBER;

BEGIN
    -- Req. 13: Validar que el empleado exista
    BEGIN
        SELECT estado, tipo_contrato, salario_base, cod_sede, acepta_aporte_vol
        INTO   v_estado, v_tipo_contrato, v_salario_base, v_cod_sede, v_acepta_vol
        FROM   EMPLEADOS
        WHERE  id_empleado = p_id_empleado;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE_APPLICATION_ERROR(-20001, &#x27;Empleado no encontrado: &#x27; || p_id_empleado);
    END;

    -- Req. 14: Validar estado activo
    IF v_estado != &#x27;ACTIVO&#x27; THEN
        RAISE_APPLICATION_ERROR(-20002, &#x27;Empleado no activo: estado = &#x27; || v_estado);
    END IF;

    -- Req. 15: Validar que no exista liquidación previa
    SELECT COUNT(*) INTO v_cnt_liq
    FROM   LIQUIDACION
    WHERE  id_empleado = p_id_empleado AND id_quincena = p_id_quincena;

    IF v_cnt_liq &gt; 0 THEN
        RAISE_APPLICATION_ERROR(-20003,
            &#x27;Liquidación ya existe para empleado &#x27; || p_id_empleado ||
            &#x27; quincena &#x27; || p_id_quincena);
    END IF;

    -- Leer parámetros
    SELECT valor_numerico INTO v_smlmv        FROM PARAMETROS WHERE cod_parametro = &#x27;SMLMV&#x27;;
    SELECT valor_numerico INTO v_pct_salud    FROM PARAMETROS WHERE cod_parametro = &#x27;PCT_SALUD&#x27;;
    SELECT valor_numerico INTO v_pct_pension  FROM PARAMETROS WHERE cod_parametro = &#x27;PCT_PENSION&#x27;;
    SELECT valor_numerico INTO v_pct_fondo    FROM PARAMETROS WHERE cod_parametro = &#x27;PCT_FONDO_SOLIDARIDAD&#x27;;
    SELECT valor_numerico INTO v_umbral_fondo FROM PARAMETROS WHERE cod_parametro = &#x27;UMBRAL_FONDO_SMLMV&#x27;;
    SELECT valor_numerico INTO v_aporte_vol_bog FROM PARAMETROS WHERE cod_parametro = &#x27;APORTE_VOL_BOG&#x27;;
    SELECT valor_numerico INTO v_aux_mensual  FROM PARAMETROS WHERE cod_parametro = &#x27;AUX_TRANSPORTE&#x27;;

    -- Req. 16: Calcular conceptos usando funciones del Punto 2
    v_base_q       := fn_salario_base_q(p_id_empleado, p_id_quincena);
    v_recargos     := fn_recargos(p_id_empleado, p_id_quincena);
    v_bonificacion := fn_bonificacion(p_id_empleado);

    -- Auxilio de transporte
    IF v_tipo_contrato IN (&#x27;PLANTA&#x27;, &#x27;TEMPORAL&#x27;) THEN
        IF v_tipo_contrato = &#x27;PLANTA&#x27; THEN
            v_base_mensual := v_salario_base;
        ELSE
            BEGIN
                SELECT NVL(cantidad_horas, 0) INTO v_horas_normales
                FROM   HORAS_TRABAJADAS
                WHERE  id_empleado = p_id_empleado AND id_quincena = p_id_quincena AND tipo_hora = &#x27;NORMAL&#x27;;
            EXCEPTION WHEN NO_DATA_FOUND THEN v_horas_normales := 0;
            END;
            v_base_mensual := v_salario_base * v_horas_normales * 2;
        END IF; 
        IF v_base_mensual &lt;= 2 * v_smlmv THEN
            v_aux_transp := v_aux_mensual / 2;
        END IF;
    END IF;

    -- Bono sede
    IF v_tipo_contrato IN (&#x27;PLANTA&#x27;, &#x27;TEMPORAL&#x27;) AND v_cod_sede = &#x27;SMA&#x27; THEN
        SELECT valor_numerico INTO v_bono_sede FROM PARAMETROS WHERE cod_parametro = &#x27;BONO_CLIMA_SMA&#x27;;
    END IF;

    -- REGLA 6: Bruto
    v_bruto := v_base_q + v_recargos + v_bonificacion + v_aux_transp + v_bono_sede;

    -- REGLA 7: Deducciones
    v_salud   := ROUND(v_bruto * v_pct_salud   / 100, 2);
    v_pension := ROUND(v_bruto * v_pct_pension / 100, 2);

    -- Fondo de solidaridad
    IF (v_bruto * 2) &gt; (v_umbral_fondo * v_smlmv) THEN
        v_fondo := ROUND(v_bruto * v_pct_fondo / 100, 2);
    END IF;

    -- Embargo
    v_base_embargo := v_bruto - v_salud - v_pension - v_fondo;
    BEGIN
        SELECT NVL(SUM(porcentaje), 0) INTO v_embargo
        FROM   EMBARGOS
        WHERE  id_empleado = p_id_empleado AND estado = &#x27;ACTIVO&#x27;;
        v_embargo := ROUND(v_base_embargo * v_embargo / 100, 2);
    EXCEPTION WHEN NO_DATA_FOUND THEN v_embargo := 0;
    END;

    -- Libranzas
    BEGIN
        SELECT NVL(SUM(cuota_mensual), 0) / 2 INTO v_libranzas
        FROM   LIBRANZAS
        WHERE  id_empleado = p_id_empleado AND estado = &#x27;ACTIVA&#x27;;
    EXCEPTION WHEN NO_DATA_FOUND THEN v_libranzas := 0;
    END;

    -- Aporte voluntario Bogotá
    IF v_cod_sede = &#x27;BOG&#x27; AND v_acepta_vol = &#x27;S&#x27; THEN
        v_aporte_vol := v_aporte_vol_bog;
    END IF;

    v_total_ded := v_salud + v_pension + v_fondo + v_embargo + v_libranzas + v_aporte_vol;

    -- REGLA 8: Neto
    v_neto := v_bruto - v_total_ded;

    -- Req. 17: Caso especial neto negativo
    v_embargo_orig  := v_embargo;
    v_libranzas_orig := v_libranzas;

    IF v_neto &lt; 0 THEN
        v_embargo   := 0;
        v_total_ded := v_salud + v_pension + v_fondo + v_embargo + v_libranzas + v_aporte_vol;
        v_neto      := v_bruto - v_total_ded;
        IF v_neto &lt; 0 THEN
            v_libranzas := 0;
            v_total_ded := v_salud + v_pension + v_fondo + v_embargo + v_libranzas + v_aporte_vol;
            v_neto      := v_bruto - v_total_ded;
        END IF;
    END IF;

    -- Req. 18: Insertar en LIQUIDACION
    INSERT INTO LIQUIDACION (
        id_liquidacion, id_empleado, id_quincena,
        salario_base_q, recargos, bonificacion, auxilio_transp, bono_sede,
        bruto,
        deduccion_salud, deduccion_pension, fondo_solidaridad,
        embargo, libranzas, aporte_voluntario,
        total_deducciones, neto
    ) VALUES (
        SEQ_LIQUIDACION.NEXTVAL, p_id_empleado, p_id_quincena,
        v_base_q, v_recargos, v_bonificacion, v_aux_transp, v_bono_sede,
        v_bruto,
        v_salud, v_pension, v_fondo,
        v_embargo, v_libranzas, v_aporte_vol,
        v_total_ded, v_neto
    );

    -- Req. 19: COMMIT
    COMMIT;

EXCEPTION
    WHEN OTHERS THEN
        ROLLBACK;
        RAISE;
END sp_liquidar_empleado;
/


---
import Layout from '../layouts/BlogPost.astro';
import GlowLineSeparator from '@/components/ui/separator/GlowLineSeparator.astro';
const pageTitle = 'Evidencias';
const pageDescription = 'SQL | PL/SQL Scripts | NoSQL | Proyecto';
---

<Layout title={pageTitle} description={pageDescription} pubDate={new Date()} showHeader={false}>
  <div class="ev-intro">
    <p class="ev-desc">
      Aquí se irán anexando los diferentes ejercicios y el progreso realizado en clase y casa,
      tanto de los temas como del proyecto final.
    </p>
  </div>

  <GlowLineSeparator />

  <nav class="ev-grid" aria-label="Subsecciones de Evidencias">

    <a href="/sql" class="ev-card ev-card--sql">
      <div class="ev-card__icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <ellipse cx="12" cy="5" rx="9" ry="3"/>
          <path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/>
          <path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/>
        </svg>
      </div>
      <div class="ev-card__body">
        <span class="ev-card__tag">Bases de Datos Relacionales</span>
        <h2 class="ev-card__title">SQL</h2>
        <p class="ev-card__desc">Consultas, joins, subconsultas y gestión de bases de datos relacionales.</p>
      </div>
      <div class="ev-card__arrow" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
    </a>

    <a href="/plsql" class="ev-card ev-card--plsql">
      <div class="ev-card__icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="16 18 22 12 16 6"/>
          <polyline points="8 6 2 12 8 18"/>
        </svg>
      </div>
      <div class="ev-card__body">
        <span class="ev-card__tag">Programación Procedural</span>
        <h2 class="ev-card__title">PL/SQL</h2>
        <p class="ev-card__desc">Bloques anónimos, procedimientos almacenados, funciones y triggers en Oracle.</p>
      </div>
      <div class="ev-card__arrow" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
    </a>

    <a href="/nosql" class="ev-card ev-card--nosql">
      <div class="ev-card__icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
        </svg>
      </div>
      <div class="ev-card__body">
        <span class="ev-card__tag">Bases de Datos No Relacionales</span>
        <h2 class="ev-card__title">NoSQL</h2>
        <p class="ev-card__desc">Documentos, colecciones y consultas en MongoDB y otros motores NoSQL.</p>
      </div>
      <div class="ev-card__arrow" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
    </a>

    <a href="/proyecto" class="ev-card ev-card--proyecto">
      <div class="ev-card__icon">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg>
      </div>
      <div class="ev-card__body">
        <span class="ev-card__tag">Proyecto Integrador</span>
        <h2 class="ev-card__title">Proyecto</h2>
        <p class="ev-card__desc">Implementación completa de un sistema con diseño y gestión de base de datos.</p>
      </div>
      <div class="ev-card__arrow" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </div>
    </a>

  </nav>
</Layout>

<style>
  .ev-intro {
    margin-bottom: 1.5rem;
  }

  .ev-desc {
    color: var(--color-text-muted);
    font-size: 1rem;
    line-height: 1.7;
    margin: 0;
  }

  /* ── Grid ──────────────────────────────────────────────── */
  .ev-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    margin-top: 2rem;
  }

  @media (max-width: 600px) {
    .ev-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Card base ─────────────────────────────────────────── */
  .ev-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.5rem;
    border-radius: var(--radius);
    border: 1px solid var(--color-border);
    background: var(--card);
    text-decoration: none;
    color: var(--color-text-secondary);
    overflow: hidden;
    transition:
      transform 0.22s ease,
      border-color 0.22s ease,
      box-shadow 0.22s ease;
  }

  .ev-card::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.22s ease;
    pointer-events: none;
  }

  .ev-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .ev-card:hover::before {
    opacity: 1;
  }

  /* ── Icon ──────────────────────────────────────────────── */
  .ev-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    border-radius: 12px;
    border: 1px solid transparent;
    flex-shrink: 0;
    transition: transform 0.22s ease;
  }

  .ev-card:hover .ev-card__icon {
    transform: scale(1.08);
  }

  /* ── Body ──────────────────────────────────────────────── */
  .ev-card__body {
    flex: 1;
  }

  .ev-card__tag {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    margin-bottom: 0.35rem;
    opacity: 0.7;
  }

  .ev-card__title {
    font-size: 1.4rem;
    font-weight: 700;
    margin: 0 0 0.4rem;
    line-height: 1.1;
    color: var(--color-text-primary);
  }

  .ev-card__desc {
    font-size: 0.82rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }

  /* ── Arrow ─────────────────────────────────────────────── */
  .ev-card__arrow {
    align-self: flex-end;
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .ev-card:hover .ev-card__arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* ── Per-card accent colors ────────────────────────────── */

  /* SQL — sky blue */
  .ev-card--sql { --c: 125, 211, 252; }
  .ev-card--sql .ev-card__icon {
    color: rgb(125, 211, 252);
    background: rgba(125, 211, 252, 0.1);
    border-color: rgba(125, 211, 252, 0.2);
  }
  .ev-card--sql .ev-card__tag   { color: rgb(125, 211, 252); }
  .ev-card--sql .ev-card__arrow { color: rgb(125, 211, 252); }
  .ev-card--sql::before {
    background: linear-gradient(135deg, rgba(125,211,252,0.06) 0%, transparent 60%);
  }
  .ev-card--sql:hover { border-color: rgba(125, 211, 252, 0.35); }

  /* PL/SQL — amber */
  .ev-card--plsql { --c: 252, 211, 77; }
  .ev-card--plsql .ev-card__icon {
    color: rgb(252, 211, 77);
    background: rgba(252, 211, 77, 0.1);
    border-color: rgba(252, 211, 77, 0.2);
  }
  .ev-card--plsql .ev-card__tag   { color: rgb(252, 211, 77); }
  .ev-card--plsql .ev-card__arrow { color: rgb(252, 211, 77); }
  .ev-card--plsql::before {
    background: linear-gradient(135deg, rgba(252,211,77,0.06) 0%, transparent 60%);
  }
  .ev-card--plsql:hover { border-color: rgba(252, 211, 77, 0.35); }

  /* NoSQL — emerald */
  .ev-card--nosql { --c: 110, 231, 183; }
  .ev-card--nosql .ev-card__icon {
    color: rgb(110, 231, 183);
    background: rgba(110, 231, 183, 0.1);
    border-color: rgba(110, 231, 183, 0.2);
  }
  .ev-card--nosql .ev-card__tag   { color: rgb(110, 231, 183); }
  .ev-card--nosql .ev-card__arrow { color: rgb(110, 231, 183); }
  .ev-card--nosql::before {
    background: linear-gradient(135deg, rgba(110,231,183,0.06) 0%, transparent 60%);
  }
  .ev-card--nosql:hover { border-color: rgba(110, 231, 183, 0.35); }

  /* Proyecto — accent naranja del sitio */
  .ev-card--proyecto .ev-card__icon {
    color: var(--accent);
    background: rgba(255, 138, 76, 0.1);
    border-color: rgba(255, 138, 76, 0.25);
  }
  .ev-card--proyecto .ev-card__tag   { color: var(--accent); }
  .ev-card--proyecto .ev-card__arrow { color: var(--accent); }
  .ev-card--proyecto::before {
    background: linear-gradient(135deg, rgba(255,138,76,0.06) 0%, transparent 60%);
  }
  .ev-card--proyecto:hover { border-color: rgba(255, 138, 76, 0.35); }
</style>
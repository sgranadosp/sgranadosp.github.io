---
import Layout from '../layouts/BlogPost.astro';
import GlowLineSeparator from '@/components/ui/separator/GlowLineSeparator.astro';
const pageTitle = 'SQL';
const pageDescription = 'Consultas y gestión de bases de datos relacionales con SQL.';
---

<Layout title={pageTitle} description={pageDescription} pubDate={new Date()} showHeader={false}>

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/evidencias" class="breadcrumb__link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Evidencias
    </a>
  </nav>

  <!-- Page Header -->
  <header class="page-header">
    <div class="page-header__badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <ellipse cx="12" cy="5" rx="9" ry="3"/>
        <path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/>
        <path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/>
      </svg>
      Bases de Datos Relacionales
    </div>
    <h1 class="page-header__title page-header__title--sql">SQL</h1>
    <p class="page-header__sub">Structured Query Language</p>
    <p class="page-header__desc">Consultas, joins, subconsultas y gestión de bases de datos relacionales.</p>
  </header>

  <GlowLineSeparator />

  <!-- ═══════════════════════════════════════════════════════
       CONTENIDO — Añade tus bloques de código aquí debajo
       ═══════════════════════════════════════════════════════ -->
  <div class="code-content">

    <!-- Ejemplo de cómo se verá un bloque de código:
    <section class="code-block">
      <div class="code-block__header">
        <span class="code-block__label">Consulta básica — SELECT</span>
        <span class="code-block__lang">SQL</span>
      </div>
      <pre class="code-block__pre"><code>SELECT * FROM empleados WHERE departamento = 'IT';</code></pre>
    </section>
    -->

    <div class="placeholder">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" aria-hidden="true">
        <ellipse cx="12" cy="5" rx="9" ry="3"/>
        <path d="M3 5v14c0 1.66 4.03 3 9 3s9-1.34 9-3V5"/>
        <path d="M3 12c0 1.66 4.03 3 9 3s9-1.34 9-3"/>
      </svg>
      <p>Añade aquí tus ejercicios de SQL</p>
    </div>

  </div>

</Layout>

<style>
  /* ── Breadcrumb ─────────────────────────────────────────── */
  .breadcrumb {
    margin-bottom: 1.5rem;
  }

  .breadcrumb__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .breadcrumb__link:hover {
    color: rgb(125, 211, 252);
    text-decoration: none;
  }

  /* ── Page Header ────────────────────────────────────────── */
  .page-header {
    margin-bottom: 1.5rem;
  }

  .page-header__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 600;
    color: rgb(125, 211, 252);
    background: rgba(125, 211, 252, 0.08);
    border: 1px solid rgba(125, 211, 252, 0.2);
    border-radius: 100px;
    padding: 0.3rem 0.9rem;
    margin-bottom: 1rem;
  }

  .page-header__title {
    font-size: clamp(2.2rem, 6vw, 3.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    margin: 0 0 0.3rem;
  }

  .page-header__title--sql {
    background: linear-gradient(135deg, #e0f2fe 0%, #7dd3fc 55%, #38bdf8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .page-header__sub {
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin: 0 0 0.6rem;
    letter-spacing: 0.04em;
  }

  .page-header__desc {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.6;
  }

  /* ── Code Content Area ──────────────────────────────────── */
  .code-content {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  /* ── Code Block (template for your content) ─────────────── */
  .code-block {
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--card);
  }

  .code-block__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 1.1rem;
    background: rgba(125, 211, 252, 0.05);
    border-bottom: 1px solid rgba(125, 211, 252, 0.12);
  }

  .code-block__label {
    font-size: 0.78rem;
    color: rgb(125, 211, 252);
    font-weight: 500;
  }

  .code-block__lang {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    background: rgba(255,255,255,0.05);
    padding: 0.2rem 0.55rem;
    border-radius: 6px;
  }

  .code-block__pre {
    margin: 0;
    padding: 1.2rem 1.4rem;
    overflow-x: auto;
    font-size: 0.85rem;
    line-height: 1.65;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    color: var(--color-text-secondary);
  }

  /* ── Placeholder ────────────────────────────────────────── */
  .placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.9rem;
    padding: 4rem 2rem;
    border: 1px dashed rgba(125, 211, 252, 0.2);
    border-radius: var(--radius);
    color: rgba(125, 211, 252, 0.3);
    text-align: center;
  }

  .placeholder p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--color-text-muted);
  }
</style>
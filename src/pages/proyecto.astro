---
import Layout from '../layouts/BlogPost.astro';
import GlowLineSeparator from '@/components/ui/separator/GlowLineSeparator.astro';
const pageTitle = 'Proyecto';
const pageDescription = 'Proyecto integrador: CocoTech — Supermercado online con panel de administración.';
---

<Layout title={pageTitle} description={pageDescription} pubDate={new Date()} showHeader={false}>

  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/evidencias" class="breadcrumb__link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M19 12H5M12 5l-7 7 7 7"/>
      </svg>
      Evidencias
    </a>
  </nav>

  <!-- Page Header -->
  <header class="page-header">
    <div class="page-header__badge">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
      </svg>
      Proyecto Integrador
    </div>
    <h1 class="page-header__title page-header__title--proyecto">CocoTech</h1>
    <p class="page-header__sub">Full Stack · React · Node.js · MongoDB · PostgreSQL</p>
    <p class="page-header__desc">
      Supermercado online con catálogo de productos, carrito de compras, flujo de pago y
      panel de administración completo. Proyecto académico desarrollado para la Universidad El Bosque.
    </p>
    <div class="page-header__tags">
      <span class="tag">React</span>
      <span class="tag">Node.js</span>
      <span class="tag">PostgreSQL</span>
      <span class="tag">MongoDB</span>
      <span class="tag">E-commerce</span>
    </div>
  </header>

  <GlowLineSeparator />

  <div class="code-content">

    <!-- ── Sección 1: Tienda ── -->
    <section class="bitacora-section">
      <div class="section-label">
        <span class="section-num">01</span>
        <div>
          <h2 class="section-title">Tienda &amp; Catálogo</h2>
          <p class="section-desc">Página principal con hero, categorías y productos destacados.</p>
        </div>
      </div>

      <div class="gallery gallery--wide">
        <figure class="gallery__item gallery__item--full" data-caption="Página principal — Hero, categorías y productos destacados">
          <div class="gallery__img-wrap">
            <img src="/images/cocotech/COCOTECH1.jpg" alt="Página principal de CocoTech — hero y catálogo" loading="lazy" />
            <div class="gallery__overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          <figcaption>Página principal — Hero, categorías y productos destacados</figcaption>
        </figure>

        <figure class="gallery__item gallery__item--full" data-caption="Vista de carrito con resumen del pedido">
          <div class="gallery__img-wrap">
            <img src="/images/cocotech/COCOTECH2.jpg" alt="Carrito de compras de CocoTech" loading="lazy" />
            <div class="gallery__overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          <figcaption>Carrito de compras — Resumen del pedido e IVA calculado</figcaption>
        </figure>
      </div>
    </section>

    <!-- ── Sección 2: Auth ── -->
    <section class="bitacora-section">
      <div class="section-label">
        <span class="section-num">02</span>
        <div>
          <h2 class="section-title">Autenticación</h2>
          <p class="section-desc">Flujo de inicio de sesión y registro de nuevos usuarios.</p>
        </div>
      </div>

      <div class="gallery gallery--two">
        <figure class="gallery__item" data-caption="Pantalla de login con split-layout">
          <div class="gallery__img-wrap">
            <img src="/images/cocotech/LOGIN1.jpg" alt="Login de CocoTech" loading="lazy" />
            <div class="gallery__overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          <figcaption>Iniciar sesión — Split layout con features destacados</figcaption>
        </figure>

        <figure class="gallery__item" data-caption="Formulario de registro de nuevo usuario">
          <div class="gallery__img-wrap">
            <img src="/images/cocotech/REGISTER1.jpg" alt="Registro de usuario en CocoTech" loading="lazy" />
            <div class="gallery__overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          <figcaption>Crear cuenta — Datos personales y dirección de entrega</figcaption>
        </figure>
      </div>
    </section>

    <!-- ── Sección 3: Checkout ── -->
    <section class="bitacora-section">
      <div class="section-label">
        <span class="section-num">03</span>
        <div>
          <h2 class="section-title">Flujo de Pago</h2>
          <p class="section-desc">Checkout en 3 pasos: entrega → método de pago → confirmación.</p>
        </div>
      </div>

      <div class="gallery gallery--three">
        <figure class="gallery__item" data-caption="Paso 2: Selección del método de pago">
          <div class="gallery__img-wrap">
            <img src="/images/cocotech/PAYMENT2.jpg" alt="Método de pago — Checkout CocoTech" loading="lazy" />
            <div class="gallery__overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          <figcaption>Paso 2 — Método de pago (efectivo, tarjeta, PSE)</figcaption>
        </figure>

        <figure class="gallery__item" data-caption="Paso 3: Revisión y confirmación del pedido">
          <div class="gallery__img-wrap">
            <img src="/images/cocotech/PAYMENT3.jpg" alt="Confirmación del pedido — CocoTech" loading="lazy" />
            <div class="gallery__overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          <figcaption>Paso 3 — Revisión del pedido antes de confirmar</figcaption>
        </figure>

        <figure class="gallery__item" data-caption="Pedido confirmado exitosamente">
          <div class="gallery__img-wrap">
            <img src="/images/cocotech/PAYMENT4.jpg" alt="Pedido confirmado — CocoTech" loading="lazy" />
            <div class="gallery__overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          <figcaption>¡Pedido confirmado! — Pantalla de éxito</figcaption>
        </figure>
      </div>
    </section>

    <!-- ── Sección 4: Seguimiento ── -->
    <section class="bitacora-section">
      <div class="section-label">
        <span class="section-num">04</span>
        <div>
          <h2 class="section-title">Seguimiento de Pedido</h2>
          <p class="section-desc">Vista de detalle con tracking en 5 etapas y resumen de productos.</p>
        </div>
      </div>

      <div class="gallery gallery--wide">
        <figure class="gallery__item gallery__item--full" data-caption="Detalle del pedido con tracking y desglose de costos">
          <div class="gallery__img-wrap">
            <img src="/images/cocotech/ORDER.jpg" alt="Seguimiento de pedido — CocoTech" loading="lazy" />
            <div class="gallery__overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          <figcaption>Detalle del pedido — Tracking, productos, IVA y envío</figcaption>
        </figure>
      </div>
    </section>

    <!-- ── Sección 5: Admin ── -->
    <section class="bitacora-section">
      <div class="section-label">
        <span class="section-num">05</span>
        <div>
          <h2 class="section-title">Panel de Administración</h2>
          <p class="section-desc">Dashboard con métricas, gráficas de ventas y gestión de facturas.</p>
        </div>
      </div>

      <div class="gallery gallery--two">
        <figure class="gallery__item" data-caption="Dashboard — KPIs, ingresos por sucursal y top productos">
          <div class="gallery__img-wrap">
            <img src="/images/cocotech/ADMIN.jpg" alt="Dashboard admin CocoTech" loading="lazy" />
            <div class="gallery__overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          <figcaption>Dashboard — KPIs, ingresos por sucursal y top productos vendidos</figcaption>
        </figure>

        <figure class="gallery__item" data-caption="Módulo de facturas — Proyección a MongoDB">
          <div class="gallery__img-wrap">
            <img src="/images/cocotech/ADMIN2.jpg" alt="Facturas admin CocoTech" loading="lazy" />
            <div class="gallery__overlay">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
            </div>
          </div>
          <figcaption>Facturas — Generación automática y reproyección a MongoDB</figcaption>
        </figure>
      </div>
    </section>

  </div>

</Layout>

<!-- ═══════════════════ LIGHTBOX ═══════════════════ -->
<div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Vista ampliada">
  <button class="lightbox__close" id="lightboxClose" aria-label="Cerrar">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6 6 18M6 6l12 12"/></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--prev" id="lightboxPrev" aria-label="Anterior">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M15 18l-6-6 6-6"/></svg>
  </button>
  <button class="lightbox__nav lightbox__nav--next" id="lightboxNext" aria-label="Siguiente">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M9 18l6-6-6-6"/></svg>
  </button>
  <div class="lightbox__content">
    <img class="lightbox__img" id="lightboxImg" src="" alt="" />
    <p class="lightbox__caption" id="lightboxCaption"></p>
  </div>
</div>

<script>
  const items = Array.from(document.querySelectorAll('.gallery__item'));
  const lightbox = document.getElementById('lightbox') as HTMLElement;
  const lbImg = document.getElementById('lightboxImg') as HTMLImageElement;
  const lbCaption = document.getElementById('lightboxCaption') as HTMLElement;
  const lbClose = document.getElementById('lightboxClose') as HTMLButtonElement;
  const lbPrev = document.getElementById('lightboxPrev') as HTMLButtonElement;
  const lbNext = document.getElementById('lightboxNext') as HTMLButtonElement;
  let current = 0;

  function open(index: number) {
    current = index;
    const item = items[index];
    const img = item.querySelector('img') as HTMLImageElement;
    const cap = item.querySelector('figcaption') as HTMLElement;
    lbImg.src = img.src;
    lbImg.alt = img.alt;
    lbCaption.textContent = cap ? cap.textContent : '';
    lightbox.classList.add('lightbox--open');
    document.body.style.overflow = 'hidden';
    lbPrev.style.display = items.length > 1 ? '' : 'none';
    lbNext.style.display = items.length > 1 ? '' : 'none';
  }

  function close() {
    lightbox.classList.remove('lightbox--open');
    document.body.style.overflow = '';
  }

  items.forEach((item, i) => {
    item.addEventListener('click', () => open(i));
    item.setAttribute('tabindex', '0');
    item.addEventListener('keydown', (e: KeyboardEvent) => { if (e.key === 'Enter') open(i); });
  });

  lbClose.addEventListener('click', close);
  lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
  lbPrev.addEventListener('click', (e) => { e.stopPropagation(); open((current - 1 + items.length) % items.length); });
  lbNext.addEventListener('click', (e) => { e.stopPropagation(); open((current + 1) % items.length); });

  document.addEventListener('keydown', (e) => {
    if (!lightbox.classList.contains('lightbox--open')) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowLeft') open((current - 1 + items.length) % items.length);
    if (e.key === 'ArrowRight') open((current + 1) % items.length);
  });
</script>

<style>
  /* ── Breadcrumb ── */
  .breadcrumb { margin-bottom: 1.5rem; }
  .breadcrumb__link {
    display: inline-flex; align-items: center; gap: 0.4rem;
    font-size: 0.82rem; color: var(--color-text-muted);
    text-decoration: none; transition: color 0.18s ease;
  }
  .breadcrumb__link:hover { color: var(--accent); text-decoration: none; }

  /* ── Page Header ── */
  .page-header { margin-bottom: 1.5rem; }
  .page-header__badge {
    display: inline-flex; align-items: center; gap: 0.45rem;
    font-size: 0.65rem; letter-spacing: 0.15em; text-transform: uppercase;
    font-weight: 600; color: var(--accent);
    background: rgba(255, 138, 76, 0.08);
    border: 1px solid rgba(255, 138, 76, 0.25);
    border-radius: 100px; padding: 0.3rem 0.9rem; margin-bottom: 1rem;
  }
  .page-header__title {
    font-size: clamp(2.2rem, 6vw, 3.5rem); font-weight: 800;
    letter-spacing: -0.02em; line-height: 1; margin: 0 0 0.3rem;
  }
  .page-header__title--proyecto {
    background: linear-gradient(135deg, #ffedd5 0%, #FF8A4C 55%, #F97316 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;
  }
  .page-header__sub { font-size: 0.85rem; color: var(--color-text-muted); margin: 0 0 0.6rem; letter-spacing: 0.04em; }
  .page-header__desc { font-size: 0.95rem; color: var(--color-text-muted); margin: 0 0 1rem; line-height: 1.6; }
  .page-header__tags { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .tag {
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    padding: 0.25rem 0.65rem; border-radius: 6px;
    background: rgba(255, 138, 76, 0.07);
    border: 1px solid rgba(255, 138, 76, 0.18);
    color: var(--accent);
  }

  /* ── Content wrapper ── */
  .code-content { margin-top: 2rem; display: flex; flex-direction: column; gap: 3rem; }

  /* ── Bitácora Section ── */
  .bitacora-section { display: flex; flex-direction: column; gap: 1.2rem; }
  .section-label { display: flex; align-items: flex-start; gap: 1rem; }
  .section-num {
    flex-shrink: 0; font-size: 0.65rem; font-weight: 800; letter-spacing: 0.15em;
    color: var(--accent); background: rgba(255, 138, 76, 0.1);
    border: 1px solid rgba(255, 138, 76, 0.2);
    border-radius: 8px; padding: 0.3rem 0.6rem; margin-top: 0.1rem;
  }
  .section-title { font-size: 1.15rem; font-weight: 700; margin: 0 0 0.2rem; color: var(--color-text, #f0f0f0); }
  .section-desc { font-size: 0.85rem; color: var(--color-text-muted); margin: 0; line-height: 1.5; }

  /* ── Gallery layouts ── */
  .gallery { display: grid; gap: 0.75rem; }
  .gallery--wide { grid-template-columns: 1fr; }
  .gallery--two { grid-template-columns: repeat(2, 1fr); }
  .gallery--three { grid-template-columns: repeat(3, 1fr); }

  @media (max-width: 700px) {
    .gallery--two,
    .gallery--three { grid-template-columns: 1fr; }
  }

  /* ── Gallery Item ── */
  .gallery__item {
    margin: 0; border-radius: 10px; overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(255, 255, 255, 0.02);
    cursor: pointer; transition: transform 0.22s ease, box-shadow 0.22s ease;
  }
  .gallery__item:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.35); }
  .gallery__item:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .gallery__img-wrap { position: relative; overflow: hidden; line-height: 0; }
  .gallery__img-wrap img {
    width: 100%; height: 100%; object-fit: cover;
    display: block; transition: transform 0.35s ease;
  }
  .gallery__item--full .gallery__img-wrap img { max-height: 460px; object-fit: cover; }
  .gallery__item:hover .gallery__img-wrap img { transform: scale(1.025); }

  .gallery__overlay {
    position: absolute; inset: 0;
    display: flex; align-items: center; justify-content: center;
    background: rgba(0,0,0,0.45); color: #fff;
    opacity: 0; transition: opacity 0.22s ease;
    backdrop-filter: blur(2px);
  }
  .gallery__item:hover .gallery__overlay { opacity: 1; }

  figcaption {
    font-size: 0.75rem; color: var(--color-text-muted);
    padding: 0.55rem 0.8rem; line-height: 1.4;
    border-top: 1px solid rgba(255,255,255,0.05);
  }

  /* ══════════════════════════════════════
     LIGHTBOX
  ══════════════════════════════════════ */
  .lightbox {
    position: fixed; inset: 0; z-index: 9999;
    background: rgba(0,0,0,0.92);
    display: flex; align-items: center; justify-content: center;
    opacity: 0; pointer-events: none;
    transition: opacity 0.25s ease;
    backdrop-filter: blur(6px);
  }
  .lightbox--open { opacity: 1; pointer-events: all; }

  .lightbox__content {
    position: relative; max-width: min(90vw, 1200px);
    max-height: 90vh; display: flex; flex-direction: column;
    align-items: center; gap: 0.75rem;
  }
  .lightbox__img {
    max-width: 100%; max-height: 80vh;
    border-radius: 10px; object-fit: contain;
    box-shadow: 0 24px 64px rgba(0,0,0,0.6);
  }
  .lightbox__caption {
    font-size: 0.82rem; color: rgba(255,255,255,0.6);
    text-align: center; margin: 0; padding: 0 1rem;
  }

  .lightbox__close {
    position: fixed; top: 1.25rem; right: 1.25rem;
    width: 40px; height: 40px; border-radius: 50%;
    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15);
    color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.18s ease;
  }
  .lightbox__close:hover { background: rgba(255,255,255,0.2); }

  .lightbox__nav {
    position: fixed; top: 50%; transform: translateY(-50%);
    width: 44px; height: 44px; border-radius: 50%;
    background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15);
    color: #fff; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.18s ease;
  }
  .lightbox__nav:hover { background: rgba(255,255,255,0.2); }
  .lightbox__nav--prev { left: 1rem; }
  .lightbox__nav--next { right: 1rem; }
</style>